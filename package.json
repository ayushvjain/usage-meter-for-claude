{
  "name": "usage-meter-for-claude",
  "productName": "Usage Meter for Claude",
  "version": "0.2.0",
  "description": "A small desktop widget for Windows and macOS that shows your Claude session and weekly usage, reset countdowns and peak hours.",
  "main": "src/main/main.js",
  "author": "Ayush",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.js",
    "dist": "electron-builder --win nsis",
    "dist:store": "electron-builder --win appx",
    "dist:mac": "electron-builder --mac dmg"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.usagemeter.claude",
    "productName": "Usage Meter for Claude",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Usage Meter for Claude"
    },
    "appx": {
      "applicationId": "UsageMeterForClaude",
      "identityName": "REPLACE_WITH_PACKAGE_IDENTITY_NAME",
      "publisher": "CN=REPLACE_WITH_PUBLISHER_ID",
      "publisherDisplayName": "REPLACE_WITH_PUBLISHER_DISPLAY_NAME",
      "displayName": "Usage Meter for Claude",
      "backgroundColor": "#131B29",
      "languages": [
        "en-US"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
